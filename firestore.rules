rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profilePath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function casePath(caseId) { return /databases/$(database)/documents/cases/$(caseId); }
    function actionPath(actionId) { return /databases/$(database)/documents/actions/$(actionId); }
    function progressLogPath(logId) { return /databases/$(database)/documents/progress_logs/$(logId); }
    function progressLogEditPath(editId) { return /databases/$(database)/documents/progress_log_edits/$(editId); }
    function validProgressStatus(value) { return value in ['open', 'in_progress', 'review', 'done']; }
    function actionMatchesCase(caseId, actionId) {
      return caseId is string &&
        actionId is string &&
        exists(casePath(caseId)) &&
        exists(actionPath(actionId)) &&
        get(actionPath(actionId)).data.case_id == caseId;
    }
    // Require a new or actually corrected log, not a stale historical entry.
    function progressLogWasChangedByCaller(logId) {
      return (
        !exists(progressLogPath(logId)) &&
        existsAfter(progressLogPath(logId)) &&
        getAfter(progressLogPath(logId)).data.created_by == request.auth.uid
      ) || (
        exists(progressLogPath(logId)) &&
        existsAfter(progressLogPath(logId)) &&
        getAfter(progressLogPath(logId)).data.edited_by == request.auth.uid &&
        getAfter(progressLogPath(logId)).data.last_edit_audit_id is string &&
        !exists(progressLogEditPath(getAfter(progressLogPath(logId)).data.last_edit_audit_id)) &&
        existsAfter(progressLogEditPath(getAfter(progressLogPath(logId)).data.last_edit_audit_id)) &&
        getAfter(progressLogEditPath(getAfter(progressLogPath(logId)).data.last_edit_audit_id)).data.log_id == logId &&
        getAfter(progressLogEditPath(getAfter(progressLogPath(logId)).data.last_edit_audit_id)).data.edited_by == request.auth.uid
      );
    }
    function actionProgressMatchesLog(actionId) {
      return request.resource.data.latest_progress_log_id is string &&
        progressLogWasChangedByCaller(request.resource.data.latest_progress_log_id) &&
        getAfter(progressLogPath(request.resource.data.latest_progress_log_id)).data.action_id == actionId &&
        getAfter(progressLogPath(request.resource.data.latest_progress_log_id)).data.case_id == request.resource.data.case_id &&
        getAfter(progressLogPath(request.resource.data.latest_progress_log_id)).data.progress_after == request.resource.data.progress &&
        getAfter(progressLogPath(request.resource.data.latest_progress_log_id)).data.status_after == request.resource.data.status &&
        (
          (getAfter(progressLogPath(request.resource.data.latest_progress_log_id)).data.created_by == request.auth.uid &&
            getAfter(progressLogPath(request.resource.data.latest_progress_log_id)).data.created_at == request.resource.data.updated_at) ||
          (getAfter(progressLogPath(request.resource.data.latest_progress_log_id)).data.edited_by == request.auth.uid &&
            getAfter(progressLogPath(request.resource.data.latest_progress_log_id)).data.edited_at == request.resource.data.updated_at)
        );
    }
    function hasProfile() { return signedIn() && exists(profilePath(request.auth.uid)); }
    function profile() { return get(profilePath(request.auth.uid)).data; }
    function activeUser() { return hasProfile() && profile().active == true; }
    function isAdmin() { return activeUser() && profile().role == 'admin'; }
    function isLead() { return activeUser() && profile().role in ['admin', 'coordinator']; }
    function canWriteProgress() { return activeUser() && profile().role in ['admin', 'coordinator', 'member']; }
    function directoryMatchesProfile(uid) {
      return existsAfter(profilePath(uid)) &&
        request.resource.data.full_name == getAfter(profilePath(uid)).data.full_name &&
        request.resource.data.role == getAfter(profilePath(uid)).data.role &&
        request.resource.data.active == (getAfter(profilePath(uid)).data.active == true) &&
        request.resource.data.deleted == (getAfter(profilePath(uid)).data.get('deleted', false) == true);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // First Admin profile is provisioned once in Firebase Console. Afterwards only Admins manage profiles.
      allow create: if isAdmin() && request.resource.data.role in ['admin','coordinator','member','viewer'] && request.resource.data.active == true;
      allow update: if isAdmin() && request.resource.data.role in ['admin','coordinator','member','viewer'];
      allow delete: if false;
    }
    match /team_directory/{uid} {
      // Minimal directory fields for active staff to select PICs and resolve Action owner names.
      allow read: if activeUser();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['full_name', 'role', 'active', 'deleted']) &&
        request.resource.data.keys().hasOnly(['full_name', 'role', 'active', 'deleted']) &&
        request.resource.data.full_name is string &&
        request.resource.data.full_name.size() > 0 &&
        request.resource.data.role in ['admin','coordinator','member','viewer'] &&
        request.resource.data.active is bool &&
        request.resource.data.deleted is bool &&
        directoryMatchesProfile(uid);
      allow delete: if false;
    }
    match /cases/{caseId} {
      allow read: if activeUser();
      allow create: if isLead() && request.resource.data.created_by == request.auth.uid;
      allow update, delete: if isLead();
    }
    match /actions/{actionId} {
      allow read: if activeUser();
      // Every Action must belong to an existing Case.
      allow create: if isLead() &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.case_id is string &&
        exists(casePath(request.resource.data.case_id));
      allow update: if
        (isLead() &&
          request.resource.data.case_id is string &&
          exists(casePath(request.resource.data.case_id)) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['progress','status','latest_progress_log_id']) ||
            actionProgressMatchesLog(actionId))) ||
        (activeUser() && profile().role == 'member' &&
          resource.data.assigned_to == request.auth.uid &&
          request.resource.data.assigned_to == resource.data.assigned_to &&
          request.resource.data.case_id == resource.data.case_id &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress','status','updated_at','latest_progress_log_id']) &&
          request.resource.data.progress is int &&
          request.resource.data.progress >= 0 &&
          request.resource.data.progress <= 100 &&
          validProgressStatus(request.resource.data.status) &&
          request.resource.data.updated_at is string &&
          actionProgressMatchesLog(actionId));
      allow delete: if isLead();
    }
    match /progress_logs/{logId} {
      allow read: if activeUser();

      // A progress entry must point to an existing Action and its actual parent Case.
      // The Action's summary progress/status are updated in the same atomic batch.
      allow create: if canWriteProgress() &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.case_id is string &&
        request.resource.data.action_id is string &&
        actionMatchesCase(request.resource.data.case_id, request.resource.data.action_id) &&
        (isLead() ||
          (profile().role == 'member' && get(actionPath(request.resource.data.action_id)).data.assigned_to == request.auth.uid)) &&
        request.resource.data.update_text is string &&
        request.resource.data.progress_before is int &&
        request.resource.data.progress_before >= 0 &&
        request.resource.data.progress_before <= 100 &&
        request.resource.data.progress_after is int &&
        request.resource.data.progress_after >= 0 &&
        request.resource.data.progress_after <= 100 &&
        validProgressStatus(request.resource.data.status_after) &&
        request.resource.data.blocker is string &&
        request.resource.data.next_step is string &&
        request.resource.data.created_at is string &&
        getAfter(actionPath(request.resource.data.action_id)).data.progress == request.resource.data.progress_after &&
        getAfter(actionPath(request.resource.data.action_id)).data.status == request.resource.data.status_after &&
        getAfter(actionPath(request.resource.data.action_id)).data.updated_at == request.resource.data.created_at;

      // Only the original author or a lead can correct a progress entry.
      // Its author, timestamps, progress_before, and Case/Action linkage stay immutable.
      allow update: if canWriteProgress() &&
        (isLead() || (profile().role == 'member' && resource.data.created_by == request.auth.uid)) &&
        request.resource.data.edited_by == request.auth.uid &&
        request.resource.data.edited_at is string &&
        request.resource.data.update_text is string &&
        request.resource.data.progress_after is int &&
        request.resource.data.progress_after >= 0 &&
        request.resource.data.progress_after <= 100 &&
        validProgressStatus(request.resource.data.status_after) &&
        request.resource.data.blocker is string &&
        request.resource.data.next_step is string &&
        request.resource.data.last_edit_audit_id is string &&
        existsAfter(progressLogEditPath(request.resource.data.last_edit_audit_id)) &&
        getAfter(progressLogEditPath(request.resource.data.last_edit_audit_id)).data.log_id == logId &&
        getAfter(progressLogEditPath(request.resource.data.last_edit_audit_id)).data.case_id == resource.data.case_id &&
        getAfter(progressLogEditPath(request.resource.data.last_edit_audit_id)).data.action_id == resource.data.action_id &&
        getAfter(progressLogEditPath(request.resource.data.last_edit_audit_id)).data.edited_by == request.auth.uid &&
        getAfter(progressLogEditPath(request.resource.data.last_edit_audit_id)).data.created_at == request.resource.data.edited_at &&
        (
          !getAfter(progressLogEditPath(request.resource.data.last_edit_audit_id)).data.latest_update ||
          (
            getAfter(actionPath(resource.data.action_id)).data.latest_progress_log_id == logId &&
            getAfter(actionPath(resource.data.action_id)).data.progress == request.resource.data.progress_after &&
            getAfter(actionPath(resource.data.action_id)).data.status == request.resource.data.status_after &&
            getAfter(actionPath(resource.data.action_id)).data.updated_at == request.resource.data.edited_at
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'update_text', 'progress_after', 'blocker', 'next_step',
          'status_after', 'edited_at', 'edited_by', 'last_edit_audit_id'
        ]);
      allow delete: if false;
    }

    match /progress_log_edits/{editId} {
      allow read: if activeUser();
      // Append-only audit trail. Linkage and the recorded "after" state must
      // match the progress log corrected in the same atomic batch.
      allow create: if canWriteProgress() &&
        request.resource.data.edited_by == request.auth.uid &&
        request.resource.data.log_id is string &&
        request.resource.data.case_id is string &&
        request.resource.data.action_id is string &&
        request.resource.data.created_at is string &&
        request.resource.data.before is map &&
        request.resource.data.after is map &&
        request.resource.data.latest_update is bool &&
        exists(progressLogPath(request.resource.data.log_id)) &&
        get(progressLogPath(request.resource.data.log_id)).data.case_id == request.resource.data.case_id &&
        get(progressLogPath(request.resource.data.log_id)).data.action_id == request.resource.data.action_id &&
        (isLead() ||
          (profile().role == 'member' && get(progressLogPath(request.resource.data.log_id)).data.created_by == request.auth.uid)) &&
        getAfter(progressLogPath(request.resource.data.log_id)).data.case_id == request.resource.data.case_id &&
        getAfter(progressLogPath(request.resource.data.log_id)).data.action_id == request.resource.data.action_id &&
        getAfter(progressLogPath(request.resource.data.log_id)).data.edited_by == request.auth.uid &&
        getAfter(progressLogPath(request.resource.data.log_id)).data.edited_at == request.resource.data.created_at &&
        getAfter(progressLogPath(request.resource.data.log_id)).data.last_edit_audit_id == editId &&
        request.resource.data.after.update_text is string &&
        request.resource.data.after.progress_after is int &&
        request.resource.data.after.progress_after >= 0 &&
        request.resource.data.after.progress_after <= 100 &&
        validProgressStatus(request.resource.data.after.status_after) &&
        request.resource.data.after.blocker is string &&
        request.resource.data.after.next_step is string &&
        getAfter(progressLogPath(request.resource.data.log_id)).data.update_text == request.resource.data.after.update_text &&
        getAfter(progressLogPath(request.resource.data.log_id)).data.progress_after == request.resource.data.after.progress_after &&
        getAfter(progressLogPath(request.resource.data.log_id)).data.status_after == request.resource.data.after.status_after &&
        getAfter(progressLogPath(request.resource.data.log_id)).data.blocker == request.resource.data.after.blocker &&
        getAfter(progressLogPath(request.resource.data.log_id)).data.next_step == request.resource.data.after.next_step;
      allow update, delete: if false;
    }
    match /meetings/{meetingId} {
      allow read: if activeUser();
      allow create: if isLead() && request.resource.data.created_by == request.auth.uid;
      allow update, delete: if isLead();
    }
    match /counters/{counterId} {
      allow read: if isLead();
      allow create: if isLead() && counterId == 'case_sequence' && request.resource.data.value == 1;
      allow update: if isLead() && counterId == 'case_sequence' && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }
    match /app_settings/{settingId} {
      allow read: if activeUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /_system/{document=**} { allow read, write: if false; }
  }
}
